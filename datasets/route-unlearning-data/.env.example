# Hugging Face token (required for gated models such as Llama 3.2 Vision).
HF_TOKEN=

# Optional: local dataset roots may also be set here and referenced from
# configs via environment expansion, e.g. root: ${CELEBA_ROOT}
CELEBA_ROOT=/datasets/celeba
FAIRGET_ROOT=
FIUBENCH_ROOT=
MLLMU_ROOT=
PPUBENCH_ROOT=

# Optional experiment tracking
WANDB_MODE=disabled
